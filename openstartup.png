<script>

document.addEventListener("DOMContentLoaded", function () {

    const openButton =
        document.getElementById("os-menu-button");

    const megaMenu =
        document.getElementById("os-mega-menu");

    const closeButton =
        document.getElementById("os-menu-close");


    if (!openButton || !megaMenu || !closeButton) {
        console.log("OpenStartup Mega Menu: Button not found");
        return;
    }


    /* OPEN */

    function openMenu() {

        megaMenu.classList.add("os-menu-active");

        document.body.classList.add("os-menu-open");

        document.documentElement.classList.add(
            "os-menu-html-open"
        );

    }


    /* CLOSE */

    function closeMenu() {

        megaMenu.classList.remove("os-menu-active");

        document.body.classList.remove("os-menu-open");

        document.documentElement.classList.remove(
            "os-menu-html-open"
        );

    }


    /* OPEN BUTTON CLICK */

    openButton.addEventListener("click", function(event) {

        event.preventDefault();

        openMenu();

    });


    /* CLOSE BUTTON CLICK */

    closeButton.addEventListener("click", function() {

        closeMenu();

    });


    /* ESC KEY CLOSE */

    document.addEventListener("keydown", function(event) {

        if (event.key === "Escape") {

            closeMenu();

        }

    });


    /* CLOSE AFTER MENU LINK CLICK */

    const menuLinks =
        megaMenu.querySelectorAll("a");


    menuLinks.forEach(function(link) {

        link.addEventListener("click", function() {

            closeMenu();

        });

    });

});

</script> 

<style>
#floating-menu{
position:fixed;
bottom:25px;
left:50%;
transform:translate(-50%,100px);
background:#fff;
padding:18px 30px;
border-radius:60px;
box-shadow:0 10px 30px rgba(0,0,0,.15);
display:flex;
align-items:center;
gap:25px;
z-index:999999;
font-family:Arial,sans-serif;
opacity:0;
visibility:hidden;
transition:all .35s ease;
}

#floating-menu.show{
opacity:1;
visibility:visible;
transform:translate(-50%,0);
}

#floating-menu a{
text-decoration:none;
font-size:17px;
font-weight:600;
color:#222;
transition:.3s;
white-space:nowrap;
}

#floating-menu a:hover{
color:#E53935;
}

#floating-menu .close{
position:absolute;
top:-12px;
right:-12px;
width:30px;
height:30px;
border-radius:50%;
background:#E53935;
color:#fff;
display:flex;
justify-content:center;
align-items:center;
cursor:pointer;
font-size:18px;
font-weight:bold;
transition:.3s;
}

#floating-menu .close:hover{
background:#C62828;
transform:scale(1.08);
}

@media(max-width:768px){

#floating-menu{
width:92%;
padding:15px;
gap:12px;
justify-content:space-around;
}

#floating-menu a{
font-size:14px;
}

}
</style>

