    <style>

/* =========================================
   OPENSTARTUP FULL SCREEN MEGA MENU
========================================= */

 html.os-menu-html-open,
body.os-menu-open {
    overflow: hidden !important;
    height: 100% !important;
}


/* =========================================
   MAIN OVERLAY
========================================= */

#os-mega-menu {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;

    width: 100vw !important;
    height: 100vh !important;
    height: 100dvh !important;

    /* SAME DARK BACKGROUND */
    background: #090a0e !important;

    z-index: 999999999 !important;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
        opacity 0.3s ease,
        visibility 0.3s ease;

    overflow: hidden !important;
}


#os-mega-menu.os-menu-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}


/* =========================================
   GLOBAL BOX SIZING
========================================= */

#os-mega-menu *,
#os-mega-menu *::before,
#os-mega-menu *::after {
    box-sizing: border-box;
}


/* =========================================
   MAIN CONTAINER
========================================= */

.os-menu-container {
    width: 100%;
    max-width: 1500px;

    height: 100%;

    margin: 0 auto;

    padding: 12px 38px 16px;

    display: flex;
    flex-direction: column;

    background: #090a0e !important;

    overflow: hidden !important;
}


/* =========================================
   TOP BAR
========================================= */

.os-menu-top {
    min-height: 70px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    flex-shrink: 0;

    padding-bottom: 12px;

    background: #090a0e !important;

    border-bottom:
        1px solid rgba(255,255,255,0.10);
}


/* =========================================
   LOGO
========================================= */

.os-menu-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
}


.os-menu-logo img {
    display: block;

    width: 180px;
    max-width: 100%;

    height: auto;

    object-fit: contain;
}


/* =========================================
   CLOSE BUTTON
========================================= */

#os-menu-close {
    width: 50px;
    height: 50px;

    border: none !important;
    border-radius: 0 !important;

    background: transparent !important;

    cursor: pointer;

    position: relative;

    padding: 0;

    flex-shrink: 0;

    outline: none !important;
}


#os-menu-close::before,
#os-menu-close::after {
    content: "";

    position: absolute;

    width: 24px;
    height: 2px;

    background: #d8dce3;

    top: 50%;
    left: 50%;

    border-radius: 2px;

    transition:
        background 0.25s ease,
        transform 0.25s ease;
}


#os-menu-close::before {
    transform:
        translate(-50%, -50%)
        rotate(45deg);
}


#os-menu-close::after {
    transform:
        translate(-50%, -50%)
        rotate(-45deg);
}


#os-menu-close:hover::before,
#os-menu-close:hover::after {
    background: #ff5a1f;
}


/* =========================================
   MENU GRID
========================================= */

.os-menu-grid {
    flex: 1;

    min-height: 0;

    display: grid;

    grid-template-columns:
        0.9fr
        1fr
        1.1fr
        1.45fr;

    gap: 0;

    padding-top: 10px;

    background: #090a0e !important;

    overflow: hidden !important;
}


/* =========================================
   MENU COLUMNS
========================================= */

.os-menu-column {
    padding:
        10px
        38px
        10px
        0;

    background: #090a0e !important;

    border-right:
        1px solid rgba(255,255,255,0.10);
}


.os-menu-column:not(:first-child) {
    padding-left: 38px;
}


.os-menu-column:last-child {
    border-right: none;
}


/* =========================================
   MENU HEADINGS
========================================= */

.os-menu-heading {
    color: #ff6a2c;

    font-size: 13px;

    font-weight: 700;

    letter-spacing: 2px;

    margin-bottom: 22px;

    text-transform: uppercase;
}


/* =========================================
   MENU LINKS
========================================= */

.os-menu-column > a {
    display: block;

    color: #d5d8de;

    text-decoration: none;

    font-size: 17px;

    line-height: 1.3;

    margin-bottom: 18px;

    transition:
        color 0.2s ease,
        transform 0.2s ease;
}


.os-menu-column > a:hover {
    color: #ff6a2c;

    transform: translateX(5px);
}


/* =========================================
   OFFICE SECTION
========================================= */

.os-office {
    padding-top: 4px;
    padding-bottom: 13px;

    margin-bottom: 10px;

    border-bottom:
        1px solid rgba(255,255,255,0.09);
}


.os-office:last-child {
    margin-bottom: 0;
    border-bottom: none;
}


/* OFFICE TITLE */

.os-office-title {
    display: flex;

    align-items: center;

    gap: 10px;

    color: #f2f2f2;

    font-size: 16px;

    font-weight: 700;

    margin-bottom: 7px;
}


/* LOCATION DOT */

.os-location-icon {
    width: 9px;
    height: 9px;

    flex-shrink: 0;

    border-radius: 50%;

    background: #ff5a1f;

    box-shadow:
        0 0 10px
        rgba(255,90,31,0.4);
}


/* OFFICE ADDRESS */

.os-office-address {
    color: #aeb4bf;

    font-size: 13px;

    line-height: 1.65;
}


/* =========================================
   BOTTOM SECTION
========================================= */

.os-menu-bottom {
    min-height: 96px;

    flex-shrink: 0;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 25px;

    padding-top: 14px;

    background: #090a0e !important;

    border-top:
        1px solid rgba(255,255,255,0.10);
}


/* =========================================
   STATS
========================================= */

.os-stats {
    flex: 1;

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 20px;
}


.os-stat {
    display: flex;

    align-items: center;

    gap: 11px;

    min-width: 0;
}


/* STAT ICON */

.os-stat-icon {
    width: 46px;
    height: 46px;

    flex-shrink: 0;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    color: #ffffff;

    font-size: 19px;

    background:
        linear-gradient(
            135deg,
            rgba(77, 118, 255, 0.22),
            rgba(255, 90, 31, 0.12)
        );

    border:
        1px solid rgba(255,255,255,0.08);
}


/* STAT CONTENT */

.os-stat-content {
    display: flex;

    flex-direction: column;

    gap: 4px;
}


.os-stat-content strong {
    color: #ffffff;

    font-size: 15px;

    font-weight: 700;

    white-space: nowrap;
}


.os-stat-content span {
    color: #aeb4bf;

    font-size: 12px;

    white-space: nowrap;
}


/* =========================================
   RIGHT SIDE CTA
========================================= */

.os-menu-cta {
    display: flex;

    align-items: center;

    gap: 20px;

    flex-shrink: 0;
}


.os-ready-text {
    display: flex;

    flex-direction: column;

    gap: 5px;
}


.os-ready-text strong {
    color: #ffffff;

    font-size: 15px;

    font-weight: 700;

    white-space: nowrap;
}


.os-ready-text span {
    color: #aeb4bf;

    font-size: 13px;

    white-space: nowrap;
}


/* =========================================
   WHATSAPP BUTTON
========================================= */

.os-whatsapp-button {
    display: inline-flex !important;

    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    min-width: 150px;

    height: 52px;

    padding: 0 24px;

    border-radius: 30px;

    background: #25d366 !important;

    color: #ffffff !important;

    text-decoration: none;

    font-size: 15px;

    font-weight: 600;

    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
}


.os-whatsapp-button:hover {
    transform: translateY(-3px);

    box-shadow:
        0 10px 25px
        rgba(37,211,102,0.25);
}


/* =========================================
   TABLET
========================================= */

@media (max-width: 1200px) {

    .os-menu-container {
        padding:
            15px
            28px;
    }


    .os-menu-grid {
        grid-template-columns:
            repeat(2, 1fr);

        overflow-y: auto !important;
    }


    .os-menu-column:nth-child(2) {
        border-right: none;
    }


    .os-menu-column:nth-child(3),
    .os-menu-column:nth-child(4) {
        margin-top: 15px;
    }


    .os-menu-bottom {
        flex-direction: column;

        align-items: stretch;
    }


    .os-stats {
        grid-template-columns:
            repeat(4, 1fr);
    }


    .os-menu-cta {
        justify-content: flex-end;
    }

}


/* =========================================
   MOBILE
========================================= */

@media (max-width: 767px) {

    .os-menu-container {
        padding:
            12px
            20px;
    }


    .os-menu-top {
        min-height: 58px;

        padding-bottom: 10px;
    }


    .os-menu-logo img {
        width: 155px;
    }


