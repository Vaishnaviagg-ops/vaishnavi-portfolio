</div>

<script>
document.addEventListener("DOMContentLoaded",function(){

const popup=document.getElementById("os-popup-overlay");
const close=document.getElementById("os-close");

const last=localStorage.getItem("os_popup_last");

if(last){
const diff=Date.now()-parseInt(last);
if(diff<24*60*60*1000)return;
}

let shown=false;

function showPopup(){
if(shown)return;
shown=true;
popup.style.display="flex";
localStorage.setItem("os_popup_last",Date.now());
}

if(window.innerWidth<768){
setTimeout(showPopup,30000);
}else{
setTimeout(showPopup,45000);

window.addEventListener("scroll",function(){
if(shown)return;
const max=document.documentElement.scrollHeight-window.innerHeight;
if(max>0 && window.scrollY/max>=0.6){
showPopup();
}
});
}

close.onclick=function(){
popup.style.display="none";
};

popup.onclick=function(e){
if(e.target===popup){
popup.style.display="none";
}
};

document.addEventListener("keydown",function(e){
if(e.key==="Escape"){
popup.style.display="none";
}
});

});
</script>

