    }


    .os-stat-icon {
        width: 40px;
        height: 40px;

        font-size: 16px;
    }


    .os-stat-content strong {
        font-size: 13px;

        white-space: normal;
    }


    .os-stat-content span {
        font-size: 10px;

        white-space: normal;
    }


    .os-menu-cta {
        flex-direction: column;

        align-items: stretch;

        gap: 15px;
    }


    .os-ready-text {
        align-items: center;

        text-align: center;
    }


    .os-whatsapp-button {
        width: 100%;
    }

}

