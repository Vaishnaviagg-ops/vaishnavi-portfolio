<meta name="viewport" content="width=device-width,initial-scale=1">
<title>OpenStartup Popup</title>

<style>
#os-popup-overlay{
position:fixed;inset:0;
background:rgba(0,0,0,.65);
display:none;
justify-content:center;
align-items:center;
z-index:999999;
font-family:Arial,sans-serif;
padding:20px;
}

#os-popup{
width:1000px;
max-width:95%;
height:90vh;
background:#fff;
border-radius:18px;
overflow:hidden;
display:flex;
position:relative;
box-shadow:0 25px 60px rgba(0,0,0,.25);
animation:popup .35s ease;
}

@keyframes popup{
from{opacity:0;transform:scale(.9)}
to{opacity:1;transform:scale(1)}
}

#os-left{
width:35%;
background:linear-gradient(180deg,#6a35ff,#8b5cf6);
color:#fff;
padding:35px 30px;
overflow:auto;
}

#os-left h2{
font-size:42px;
margin:0 0 20px;
line-height:1.2;
}

#os-left p{
font-size:18px;
line-height:1.8;
}

#os-left ul{
padding:0;
list-style:none;
margin-top:30px;
}

#os-left li{
margin:18px 0;
font-size:18px;
}

#os-right{
width:65%;
background:#fff;
padding:25px;
overflow-y:auto;
}

#os-right h2{
margin:0;
font-size:34px;
}

#os-right p{
margin:10px 0 20px;
color:#666;
}

#os-right iframe{
width:100%;
height:1200px;
border:0;
}

#os-close{
position:fixed;
top:20px;
right:20px;
width:46px;
height:46px;
background:#e53935;
border-radius:50%;
display:flex;
align-items:center;
justify-content:center;
color:#fff;
font-size:28px;
font-weight:bold;
cursor:pointer;
z-index:1000000;
box-shadow:0 10px 25px rgba(0,0,0,.3);
transition:.3s;
}

#os-close:hover{
background:#c62828;
transform:rotate(90deg);
}

@media(max-width:768px){
#os-popup{
flex-direction:column;
height:90vh;
}
#os-left,#os-right{
width:100%;
}
#os-left h2{font-size:30px}
#os-right iframe{height:1000px}
}
</style>



<div id="os-popup-overlay" style="display: none;">
<div id="os-popup">

<div id="os-left">
<h2>Grow Your Business <img draggable="false" role="img" class="emoji" alt="🚀" src="./openstartup_files/1f680.svg"></h2>

